{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "ov_mix",
  "position": {
    "x": 240,
    "y": 150,
    "z": 5000,
    "height": 550,
    "width": 620,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "lineStackedColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "year_month"
                }
              },
              "queryRef": "dim_date.year_month",
              "nativeQueryRef": "year_month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_generation"
                    }
                  },
                  "Property": "Avg Wind MW"
                }
              },
              "queryRef": "fact_generation.Avg Wind MW",
              "nativeQueryRef": "Avg Wind MW"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_generation"
                    }
                  },
                  "Property": "Avg Solar MW"
                }
              },
              "queryRef": "fact_generation.Avg Solar MW",
              "nativeQueryRef": "Avg Solar MW"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_generation"
                    }
                  },
                  "Property": "Avg Demand MW"
                }
              },
              "queryRef": "fact_generation.Avg Demand MW",
              "nativeQueryRef": "Avg Demand MW"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "dim_date"
                  }
                },
                "Property": "year_month"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly Wind and Solar vs Demand (average MW)'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "start": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            },
            "end": {
              "expr": {
                "Literal": {
                  "Value": "25000D"
                }
              }
            },
            "secStart": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            },
            "secEnd": {
              "expr": {
                "Literal": {
                  "Value": "25000D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
