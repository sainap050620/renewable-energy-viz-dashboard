table dim_zone
	lineageTag: edb42b11-e658-596c-b881-20b51c9cf6af

	column zone_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 824a9d8d-8949-58d5-bfbf-e0c890574058
		summarizeBy: none
